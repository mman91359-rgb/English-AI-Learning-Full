# ==========================================================
# English AI 部署环境变量配置
# 使用方法：复制本文件为 .env，填入真实值后再 docker compose up
#   cp .env.example .env
# ==========================================================

# ---------- MySQL 数据库 ----------
# root 密码（首次初始化用，务必改成强密码）
MYSQL_ROOT_PASSWORD=ChangeMe_Root_2026!
# 业务连接用户名（默认用 root，生产建议建独立账号）
MYSQL_USERNAME=root
# 业务连接密码（与 MYSQL_ROOT_PASSWORD 保持一致，因默认用 root）
MYSQL_PASSWORD=ChangeMe_Root_2026!

# ---------- JWT 认证 ----------
# JWT 签名密钥，生产必须改成 32 字节以上的随机串
JWT_SECRET=ChangeMe-Production-JWT-Secret-Please-Use-Random-String-32Bytes

# ---------- AI 服务（阿里云百炼 / 硅基流动） ----------
# 【必填】AI 服务 API Key，未设置将导致 ai-service 启动失败
# 阿里云百炼：https://bailian.console.aliyun.com 创建 API Key
# 硅基流动：https://siliconflow.cn 创建 API Key
DASHSCOPE_API_KEY=sk-your-real-api-key-here
# 接口地址（默认阿里云百炼兼容模式，硅基流动用 https://api.siliconflow.cn/v1）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 模型名（硅基流动用 Qwen/Qwen2.5-7B-Instruct，百炼用 qwen-plus）
DASHSCOPE_MODEL=qwen-plus
